# Poshan Mitra Environment Variables Template
PORT=5000
NODE_ENV=development

# Database Configuration
# Default local SQLite:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://username:password@localhost:5432/poshan_mitra?schema=public"

# Security Secrets (Must be changed in production)
JWT_SECRET="your_secure_jwt_secret_change_me_in_production"
JWT_EXPIRES_IN="7d"

# CORS configuration
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

